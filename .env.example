NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://sitegrid@127.0.0.1:5432/sitegrid
PUBLIC_ORIGIN=http://localhost:5173

# Development only: authorized admins receive a copyable link when SMTP is unset.
INVITATION_MANUAL_LINKS=true
# SMTP_HOST=smtp.example.test
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=sitegrid@example.test
# SMTP_USER=
# SMTP_PASSWORD=
# Production: INVITATION_MANUAL_LINKS=false. SMTP uses verified TLS/STARTTLS.
