{
  "name": "sitegrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "node --env-file=.env --import tsx --watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p apps/server/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "start": "node dist/server/main.js",
    "migrate": "node --import tsx apps/server/src/migrate-cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
