[Unit]
Description=SiteGrid HTTPS proxy
After=network.target sitegrid.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -c /etc/sitegrid/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/sitegrid/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=10
Restart=on-failure
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
